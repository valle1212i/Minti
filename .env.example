# Minti — miljövariabler för servern (server.js). ENBART NAMN, aldrig värden.
# Värden sätts i Cloud Run-tjänstens konfiguration; hemligheter via Secret Manager.

# ─── Obligatoriska (servern startar inte utan dem) ─────────────────────────────

# Kundportalens bas-URL, server-till-server (develop under test, prod vid lansering).
SOURCE_BASE_URL=

# Tenantens slug i kundportalen. Läses aldrig från inkommande request.
SOURCE_TENANT_ID=

# HEMLIG. Delad hemlighet för portalens POST /api/presentation/invalidate och
# POST /api/campaigns/webhook. Samma värde som TenantConfig.inventorySync.apiKey i portalen.
FRONTEND_SYNC_SECRET=

# ─── Valfria ───────────────────────────────────────────────────────────────────

# Portalens origins som får skicka live-förhandsvisning, kommaseparerade.
# Tom = förhandsvisning av. Samma lista styr vilka som får rama in sajten.
SOURCE_PREVIEW_ORIGINS=

# Portalens publika URL för /go/:id (navigationslänkar till portalens sidor).
# Faller tillbaka till SOURCE_BASE_URL.
PORTAL_PUBLIC_URL=

# true slår på POST /api/portal/analytics/ingest (sidvisningar utan nyckel).
PORTAL_ANALYTICS_INGEST=

# HEMLIG, valfri. Portalens API-nyckel för /api/analytics/events. Används inte i dag.
ANALYTICS_API_KEY=

# Antal betrodda proxy-hopp för X-Forwarded-For (Cloud Run: 1).
TRUSTED_PROXY_HOPS=

# Port (Cloud Run sätter den själv).
PORT=
